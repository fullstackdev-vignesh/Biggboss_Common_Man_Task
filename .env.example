# Coin alternate mode toggles a different coin-flip animation variant.
VITE_COIN_ALTERNATE_MODE=true

# Business mode (mirrors backend SLOT_BASED_BUSINESS). true (default) = show
# slot-based admin UI (Active Campaign Slot, Slot Plan selector, Campaign
# Window Breakdown, Slot Plan / Time Window filters). false = hide only the
# slot-specific admin controls. This only controls the frontend UI; the
# backend always enforces the real business rule.
NEXT_PUBLIC_SLOT_BASED_BUSINESS=true
